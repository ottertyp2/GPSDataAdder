# Doxygen configuration for GPSDataAdder.

PROJECT_NAME           = "GPSDataAdder"
PROJECT_BRIEF          = "Offline GPS L1 C/A data adder and position overlay tool"
OUTPUT_DIRECTORY       = docs/doxygen-output
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES

INPUT                  = README.md \
                         AGENTS.md \
                         app \
                         docs
RECURSIVE              = YES
FILE_PATTERNS          = *.py \
                         *.md \
                         *.dox
EXTENSION_MAPPING      = py=Python
EXCLUDE                = docs/doxygen-output
EXCLUDE_PATTERNS       = */__pycache__/* \
                         */.pytest_cache/*

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
CASE_SENSE_NAMES       = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES

JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
QUIET                  = NO
